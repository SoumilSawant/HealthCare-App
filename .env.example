# Leave VITE_FRAPPE_URL empty during local development so browser requests stay
# same-origin and use the Vite /api proxy.
VITE_FRAPPE_URL=
FRAPPE_PROXY_TARGET=http://healthcare.test:8000

# Set true only for local frontend testing. Demo mode makes no Frappe requests.
VITE_DEMO_MODE=false

# Optional server-issued API token. Do not commit a real token or expose an
# administrator token to a public browser build.
VITE_FRAPPE_API_TOKEN=

# Shown on consent records created by the web application.
VITE_CONSENT_VERSION=1.0
